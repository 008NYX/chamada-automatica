{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{views,public,node_modules/@vladmandic/face-api/model,node_modules/@vladmandic/face-api/dist}/**"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "server.js" }]
}
